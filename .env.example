# Copier en .env sur le serveur (chmod 600). Ne jamais commiter le vrai .env.
NODE_ENV=production
PORT=3000
# Nombre de reverse proxies devant Node (1 = nginx). Défaut : 1 en production.
TRUST_PROXY=1
LOG_LEVEL=info

MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.xxxxx.mongodb.net/romaterra
# Générer chaque secret avec :
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_REFRESH_SECRET=

# Origines autorisées (boutique + dashboard), séparées par des virgules.
CORS_ORIGINS=https://romaterra.tn,https://www.romaterra.tn,https://admin.romaterra.tn

IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/xxxxx

# E-mail envoyé à chaque nouvelle commande (optionnel : laissé vide = désactivé).
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
ADMIN_ORDER_EMAIL=

# Mettre à true uniquement le temps de créer le premier compte admin.
ALLOW_ADMIN_REGISTER=false
